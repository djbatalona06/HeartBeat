{
  "name": "heartbeat",
  "private": true,
  "version": "0.1.0",
  "description": "A gamified life tracker for two people.",
  "license": "MIT",
  "workspaces": [
    "app",
    "worker"
  ],
  "scripts": {
    "dev": "npm run game:build:debug && npm run dev --workspace app",
    "build": "npm run game:build && npm run build --workspace app",
    "test": "npm run test --workspace app && npm run test --workspace worker && npm run game:test",
    "typecheck": "npm run typecheck --workspace app && npm run typecheck --workspace worker",
    "game:build": "node scripts/build-game.mjs",
    "game:build:debug": "dotnet build game/HeartBeat.Game.Wasm/HeartBeat.Game.Wasm.csproj -c Debug",
    "game:test": "dotnet test game/HeartBeat.Game.Tests/HeartBeat.Game.Tests.csproj",
    "check:config": "node scripts/check-config-sync.mjs",
    "study:build": "node scripts/build-study.mjs",
    "overworld:harness": "npm run overworld:harness --workspace app",
    "gift:extract": "node gift/tools/extract.mjs",
    "gift:build": "node gift/build.mjs",
    "gift:verify": "node gift/tools/verify.mjs",
    "gift:build:music": "node gift/build.mjs --with-audio",
    "site:check": "node gift/tools/check-landing.mjs",
    "ui:check": "node scripts/check-ui-review.mjs",
    "visual": "node app/tools/visual.mjs",
    "visual:update": "node app/tools/visual.mjs --update",
    "lighthouse": "node app/tools/lighthouse.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=20"
  }
}
